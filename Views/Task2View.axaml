<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OOP_Lab5.ViewModels"
             x:Class="OOP_Lab5.Views.Task2View"
             x:DataType="vm:Task2ViewModel">
    <Grid RowDefinitions="Auto, *">
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="10">
            <Button Command="{Binding AddRandomPointsCommand}" Content="Додати 5 точок"/>
            <Button Command="{Binding ClearPointsCommand}" Content="Очистити"/>
            <CheckBox IsChecked="{Binding UseMultiThreading}" Content="Багатопоточність"/>
            <ComboBox SelectedIndex="{Binding SelectedMetricIndex}"><ComboBoxItem>Евклідова</ComboBoxItem><ComboBoxItem>Манхеттенська</ComboBoxItem></ComboBox>
            <TextBlock Text="{Binding PerformanceInfo}" VerticalAlignment="Center" FontWeight="Bold"/>
        </StackPanel>
        <Border Grid.Row="1" BorderBrush="Black" BorderThickness="2" Margin="10" Background="Gray">
            <Image Source="{Binding VoronoiImage}" Stretch="Fill" />
        </Border>
    </Grid>
</UserControl>