<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OOP_Lab5.ViewModels"
        x:Class="OOP_Lab5.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Lab 5 - Avalonia SOLID MVVM" Width="1050" Height="750"
        WindowStartupLocation="CenterScreen">
    
    <Grid RowDefinitions="Auto, *">
        <!-- Верхня панель навігації -->
        <Border Grid.Row="0" Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}" Padding="10">
            <StackPanel Orientation="Horizontal" Spacing="15" HorizontalAlignment="Center">
                <Button Command="{Binding SwitchToTask1Command}" Content="Завдання 1 (Іподром)" Width="200" HorizontalContentAlignment="Center"/>
                <Button Command="{Binding SwitchToTask2Command}" Content="Завдання 2 (Діаграма Вороного)" Width="230" HorizontalContentAlignment="Center"/>
            </StackPanel>
        </Border>
        
        <!-- Вміст завдання -->
        <TransitioningContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" />
    </Grid>
</Window>