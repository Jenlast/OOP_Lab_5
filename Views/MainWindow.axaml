<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OOP_Lab5.ViewModels"
        x:Class="OOP_Lab5.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Lab 5 - Avalonia SOLID MVVM" Width="1200" Height="800"
        WindowStartupLocation="CenterScreen">
    
    <Grid RowDefinitions="Auto, *">
        
        <!-- Панель навігації (Показується тільки ВСЕРЕДИНІ завдань) -->
        <Border Grid.Row="0" Background="#1E1E1E" Padding="10" IsVisible="{Binding IsBackButtonVisible}">
            <Button Command="{Binding GoHomeCommand}" 
                    Background="Transparent" 
                    Cursor="Hand">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="←" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock Text="На головну" FontSize="16" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Border>
        
        <!-- Вміст (Або меню з картками, або саме завдання) -->
        <TransitioningContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" />
        
    </Grid>
</Window>