<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OOP_Lab5.ViewModels"
        x:Class="OOP_Lab5.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Lab 5 - Avalonia SOLID MVVM" Width="1000" Height="700">
    <Grid RowDefinitions="Auto, *">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10" Margin="10">
            <Button Command="{Binding SwitchToTask1Command}" Content="Завдання 1 (Коні)"/>
            <Button Command="{Binding SwitchToTask2Command}" Content="Завдання 2 (Вороний)"/>
        </StackPanel>
        <TransitioningContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" />
    </Grid>
</Window>