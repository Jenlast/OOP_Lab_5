<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OOP_Lab5.ViewModels"
             x:Class="OOP_Lab5.Views.Task3View"
             x:DataType="vm:Task3ViewModel"
             x:Name="Root"
             Background="#1E1E1E">
    
    <Grid RowDefinitions="Auto, *, Auto" Margin="20">
        
        <!-- ВЕРХНЯ ПАНЕЛЬ: БАЛАНС І ПОВІДОМЛЕННЯ -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="20" HorizontalAlignment="Center">
            <TextBlock Text="Баланс: $" FontSize="24" Foreground="White" FontWeight="Bold"/>
            <TextBlock Text="{Binding Balance}" FontSize="24" Foreground="#4CAF50" FontWeight="Bold"/>
            <TextBlock Text="{Binding GameMessage}" FontSize="20" Foreground="Yellow" Margin="30,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- ІГРОВА ЗОНА -->
        <Grid Grid.Row="1" ColumnDefinitions="Auto, *" Margin="0,30">
            
            <!-- ЛІВА ЧАСТИНА: КОЛЕСО РУЛЕТКИ (300x300) -->
            <Grid Grid.Column="0" Width="300" Height="300">
                
                <!-- Самі сектори колеса -->
                <ItemsControl ItemsSource="{Binding UIWheelSectors}">
                    <!-- Обертання всього колеса -->
                    <ItemsControl.RenderTransform>
                        <RotateTransform Angle="{Binding WheelAngle}" />
                    </ItemsControl.RenderTransform>
                    
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas Width="300" Height="300" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Кожен сектор розвертається на свій кут -->
                            <Grid Width="300" Height="300">
                                <Grid.RenderTransform>
                                    <RotateTransform Angle="{Binding Angle}" />
                                </Grid.RenderTransform>
                                
                                <!-- Імітація сектора колеса -->
                                <Border Background="{Binding ColorHex}" Width="26" Height="150" 
                                        VerticalAlignment="Top" HorizontalAlignment="Center" 
                                        BorderBrush="#D4AF37" BorderThickness="1" CornerRadius="2">
                                    <TextBlock Text="{Binding Number}" Foreground="White" 
                                               HorizontalAlignment="Center" Margin="0,5,0,0"
                                               FontSize="14" FontWeight="Bold"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Центральний декоративний круг, який закриває стики секторів -->
                <Ellipse Width="180" Height="180" Fill="#2A2A2A" Stroke="#D4AF37" StrokeThickness="4" 
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Ellipse Width="40" Height="40" Fill="#D4AF37" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!-- КУЛЬКА (Збільшена і світиться) -->
                <Canvas Width="300" Height="300">
                    <Ellipse Width="12" Height="12" Fill="#FFFF00" Stroke="White" StrokeThickness="2"
                            Canvas.Left="{Binding BallX}" 
                            Canvas.Top="{Binding BallY}">
                        <!-- Робимо ефект неонового світіння замість звичайної тіні -->
                        <Ellipse.Effect>
                            <DropShadowEffect BlurRadius="10" Color="#FFFF00" OffsetX="0" OffsetY="0"/>
                        </Ellipse.Effect>
                    </Ellipse>
                </Canvas>
            </Grid>

            <!-- ПРАВА ЧАСТИНА: СТІЛ ДЛЯ СТАВОК -->
            <StackPanel Grid.Column="1" Margin="40,0,0,0" Spacing="20">
                <TextBlock Text="СТІЛ СТАВОК (Фішка: 10$)" FontSize="20" Foreground="White" HorizontalAlignment="Center"/>
                
                <!-- Ставки на колір -->
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                    <Button Content="СТАВКА НА ЧЕРВОНЕ" Background="#C62828" Foreground="White" 
                            Width="180" Height="50" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Command="{Binding PlaceColorBetCommand}" CommandParameter="Red"/>
                    
                    <Button Content="СТАВКА НА ЧОРНЕ" Background="#151515" Foreground="White" 
                            Width="180" Height="50" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Command="{Binding PlaceColorBetCommand}" CommandParameter="Black"/>
                </StackPanel>

                <!-- Ставки на числа (Плитка від 0 до 36) -->
                <ScrollViewer Height="250">
                    <ItemsControl ItemsSource="{Binding SortedTableNumbers}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ItemWidth="55" ItemHeight="55" MaxWidth="350"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Магія прив'язки: Звертаємось до DataContext головного екрану (#Root) -->
                                <Button Content="{Binding Number}" Background="{Binding ColorHex}" 
                                        Foreground="White" Width="50" Height="50" Margin="2" FontSize="18"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                        Command="{Binding #Root.DataContext.PlaceStraightBetCommand}" 
                                        CommandParameter="{Binding Number}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Grid>

        <!-- НИЖНЯ ПАНЕЛЬ: КЕРУВАННЯ ГРОЮ -->
        <Grid Grid.Row="2" ColumnDefinitions="*, Auto, Auto">
            
            <Button Grid.Column="1" Content="СКАСУВАТИ СТАВКИ" Background="#E64A19" Foreground="White" 
                    HorizontalAlignment="Right" Padding="20,15" Margin="0,0,20,0" 
                    Command="{Binding ClearBetsCommand}"/>
            
            <Button Grid.Column="2" Content="🔄 КРУТИТИ КОЛЕСО (SPIN)" Background="#D4AF37" Foreground="Black" 
                    FontWeight="Bold" FontSize="20" HorizontalAlignment="Right" Padding="40,15" 
                    Command="{Binding SpinCommand}"/>
        </Grid>
    </Grid>
</UserControl>