<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OOP_Lab5.ViewModels"
             xmlns:models="using:OOP_Lab5.Models"
             x:Class="OOP_Lab5.Views.Task1View"
             x:DataType="vm:Task1ViewModel">
    
    <Grid RowDefinitions="*, 220" ColumnDefinitions="280, *" Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
        
        <!-- ЛІВА ПАНЕЛЬ КЕРУВАННЯ -->
        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" 
                Margin="15" Padding="20"
                Background="{DynamicResource SystemRegionBrush}"
                CornerRadius="10"
                BorderBrush="{DynamicResource SystemControlBoundsBaseLowBrush}"
                BorderThickness="1"
                BoxShadow="0 4 10 0 #20000000"> 
            
            <StackPanel Spacing="15">
                <TextBlock Text="Управління" FontWeight="Bold" FontSize="22" HorizontalAlignment="Center" Margin="0,0,0,5"/>

                <StackPanel Spacing="5">
                    <TextBlock Text="Сума ставки ($):" FontWeight="Medium" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    <NumericUpDown Value="{Binding BetAmount}" Minimum="10" Increment="10" HorizontalAlignment="Stretch" FormatString="0"/>
                </StackPanel>

                <StackPanel Spacing="5">
                    <TextBlock Text="Кількість коней (2-10):" FontWeight="Medium" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    <NumericUpDown Value="{Binding HorseCount}" Minimum="2" Maximum="10" Increment="1" HorizontalAlignment="Stretch" FormatString="0"
                                   IsEnabled="{Binding !IsSimulationRunning}"/>
                </StackPanel>

                <StackPanel Spacing="5">
                    <TextBlock Text="Оберіть свого фаворита:" FontWeight="Medium" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"/>
                    <ComboBox ItemsSource="{Binding Horses}" SelectedItem="{Binding SelectedHorseForBet}" 
                              HorizontalAlignment="Stretch" PlaceholderText="Клікніть для вибору...">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:HorseModel">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Width="14" Height="14" CornerRadius="7" VerticalAlignment="Center">
                                        <Border.Background><SolidColorBrush Color="{Binding HorseColor}"/></Border.Background>
                                    </Border>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Coefficient, StringFormat='(x{0})'}" Foreground="Gray" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>
                
                <Rectangle Height="1" Fill="{DynamicResource SystemControlBoundsBaseLowBrush}" Margin="0,10"/>

                <TextBlock Text="{Binding ErrorMessage}" 
                           Foreground="#FF5252" 
                           FontWeight="SemiBold" 
                           TextWrapping="Wrap" 
                           TextAlignment="Center" 
                           Margin="0,0,0,5"/>

                <Button Command="{Binding SwitchCameraCommand}" 
                        Content="{Binding CameraButtonText}" 
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" 
                        Height="40" CornerRadius="8" Margin="0,0,0,10"
                        Background="#512DA8" Foreground="White" FontWeight="Bold"/>

                <Button Command="{Binding StartSimulationCommand}" IsEnabled="{Binding !IsSimulationRunning}" 
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Height="45" CornerRadius="8">
                    <Button.Styles>
                        <Style Selector="Button"><Setter Property="Background" Value="#008CBA"/><Setter Property="Foreground" Value="White"/></Style>
                        <Style Selector="Button:pointerover /template/ ContentPresenter"><Setter Property="Background" Value="#007399"/></Style>
                        <Style Selector="Button:disabled /template/ ContentPresenter"><Setter Property="Background" Value="Gray"/></Style>
                    </Button.Styles>
                    <TextBlock Text="Запустити забіг!" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                </Button>
            </StackPanel>
        </Border>

        <!-- ПРАВА ЧАСТИНА - ТРАСА -->
        <Border Grid.Row="0" Grid.Column="1" 
                BorderBrush="{DynamicResource SystemControlBoundsBaseMediumBrush}" 
                BorderThickness="2" CornerRadius="8" ClipToBounds="True" Margin="0,15,15,10"> 
            
            <Border.Background>
                <ImageBrush Source="/Assets/Images/Background/Track.png" Stretch="Fill"/>
            </Border.Background>

            <Grid>
                <Canvas>
                    <TextBlock Text="ФІНІШ" Canvas.Left="{Binding FinishLineViewPositionX}" Canvas.Top="80" FontWeight="Heavy" Foreground="White" FontSize="14" LetterSpacing="2"/>
                    <Border Canvas.Left="{Binding FinishLineViewPositionX}" Canvas.Top="100" Width="10" Height="30" Background="#D32F2F" CornerRadius="3" BorderBrush="White" BorderThickness="1"/>
                    <Line Canvas.Left="{Binding FinishLineViewPositionX}" StartPoint="5, 130" EndPoint="5, 800" Stroke="White" StrokeThickness="5" StrokeDashArray="3,3" Opacity="0.8"/>
                </Canvas>

                <ItemsControl ItemsSource="{Binding Horses}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:HorseModel">
                            <Grid Width="100" Height="60">
                                <Image Source="{Binding CurrentFrame}" Stretch="Uniform" />
                                <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" CornerRadius="4" Margin="0,0,0,-15" Padding="6,2" BoxShadow="0 2 4 0 #40000000">
                                    <Border.Background><SolidColorBrush Color="{Binding HorseColor}"/></Border.Background>
                                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.Styles>
                        <Style Selector="ContentPresenter" x:DataType="models:HorseModel">
                            <Setter Property="Canvas.Left" Value="{Binding ViewPositionX}"/>
                            <Setter Property="Canvas.Top" Value="{Binding ViewTop}"/>
                            <Setter Property="Transitions">
                                <Transitions>
                                    <DoubleTransition Property="Canvas.Left" Duration="0:0:0.05"/>
                                </Transitions>
                            </Setter>
                        </Style>
                    </ItemsControl.Styles>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- ПРАВА ЧАСТИНА - ТАБЛИЦЯ -->
        <Border Grid.Row="1" Grid.Column="1" 
                CornerRadius="8" Margin="0,0,15,15"
                BorderBrush="{DynamicResource SystemControlBoundsBaseLowBrush}" 
                BorderThickness="1" 
                Background="{DynamicResource SystemRegionBrush}" 
                ClipToBounds="True">
            
            <DataGrid ItemsSource="{Binding LeaderboardHorses}" AutoGenerateColumns="False" Margin="5"
                      CanUserReorderColumns="False" CanUserResizeColumns="True" CanUserSortColumns="False" 
                      IsReadOnly="True" GridLinesVisibility="All" BorderThickness="0">
                
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Місце" Binding="{Binding Rank}" Width="80"/>
                    <DataGridTextColumn Header="Ім'я коня" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Коеф." Binding="{Binding Coefficient, StringFormat='x{0}'}" Width="80"/>
                    <DataGridTextColumn Header="⏱ Час фінішу" Binding="{Binding LiveTimeDisplay}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>