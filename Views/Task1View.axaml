<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OOP_Lab5.ViewModels"
             xmlns:models="using:OOP_Lab5.Models"
             x:Class="OOP_Lab5.Views.Task1View"
             x:DataType="vm:Task1ViewModel">
    <Grid RowDefinitions="Auto, *, 200" ColumnDefinitions="250, *">
        <StackPanel Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Margin="10" Spacing="10" Background="#f0f0f0">
            <TextBlock Text="Ставки" FontWeight="Bold" FontSize="18"/>
            <TextBlock Text="{Binding Balance, StringFormat='Баланс: {0}$'}" FontSize="16"/>
            <TextBlock Text="Сума ставки:"/>
            <NumericUpDown Value="{Binding BetAmount}" Minimum="10"/>
            <TextBlock Text="Виберіть коня:"/>
            <ComboBox ItemsSource="{Binding Horses}" SelectedItem="{Binding SelectedHorseForBet}">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="models:HorseModel"><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
            <Button Command="{Binding StartSimulationCommand}" Content="Запустити забіг!" IsEnabled="{Binding !IsSimulationRunning}" Background="Green" Foreground="White" HorizontalAlignment="Stretch"/>
        </StackPanel>

        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Background="LightGreen" BorderBrush="Black" BorderThickness="2" Margin="10">
            <ItemsControl ItemsSource="{Binding Horses}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:HorseModel">
                        <Grid Width="60" Height="30">
                            <Rectangle RadiusX="5" RadiusY="5"><Rectangle.Fill><SolidColorBrush Color="{Binding HorseColor}"/></Rectangle.Fill></Rectangle>
                            <TextBlock Text="{Binding Name}" FontSize="10" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
                <ItemsControl.Styles>
                    <Style Selector="ContentPresenter" x:DataType="models:HorseModel">
                        <Setter Property="Canvas.Left" Value="{Binding PositionX}"/>
                        <Setter Property="Canvas.Top" Value="{Binding ViewTop}"/>
                    </Style>
                </ItemsControl.Styles>
            </ItemsControl>
        </Border>

        <DataGrid Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Horses}" AutoGenerateColumns="False" Margin="10">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Ранг" Binding="{Binding Rank}"/>
                <DataGridTextColumn Header="Ім'я" Binding="{Binding Name}"/>
                <DataGridTextColumn Header="Коефіцієнт" Binding="{Binding Coefficient}"/>
                <DataGridTextColumn Header="Час" Binding="{Binding FinishTime}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>